# LLM Provider: 'claude_code' (local Claude Code CLI), 'claude' (Anthropic API), or 'ollama'
LLM_PROVIDER=claude_code

# Claude Code CLI (no API key — uses the logged-in `claude` session under $HOME/.claude)
# CLAUDE_CODE_BIN=/usr/local/bin/claude   # auto-detected via PATH if unset
CLAUDE_CODE_MODEL=claude-sonnet-4-6        # set '' to use the CLI session default
CLAUDE_CODE_TIMEOUT=900

# Playwright — keep browsers project-local (self-contained). Set to an absolute
# path inside this project, then run: PLAYWRIGHT_BROWSERS_PATH=<path> playwright install chromium
# PLAYWRIGHT_BROWSERS_PATH=/abs/path/to/Intent-Aware/.browsers

# Anthropic Claude (direct API — only used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6             # current model; temperature is pinned to 0 for reproducibility

# Ollama / Local / Cloud OpenAI-compatible
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3

# In-run LLM response cache (1=on). Cache hits do not consume the call budget.
LLM_CACHE=1
# Hard ceiling on LLM calls per process — once hit, brain stages degrade to heuristics.
LLM_MAX_CALLS=200

DATABASE_URL=postgresql://user:password@localhost:5432/qa_agent
MAX_TOKEN_BUDGET=100000
RATE_LIMIT_PER_SECOND=10

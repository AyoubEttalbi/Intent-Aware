# LLM Provider: 'claude_code' (local Claude Code CLI), 'claude' (Anthropic API),
# 'opencode' (local opencode CLI), or 'ollama'
LLM_PROVIDER=claude_code

# Claude Code CLI (no API key — uses the logged-in `claude` session under $HOME/.claude)
# CLAUDE_CODE_BIN=/usr/local/bin/claude   # auto-detected via PATH if unset
CLAUDE_CODE_MODEL=claude-sonnet-5        # set '' to use the CLI session default
CLAUDE_CODE_TIMEOUT=900

# Playwright — keep browsers project-local (self-contained). Set to an absolute
# path inside this project, then run: PLAYWRIGHT_BROWSERS_PATH=<path> playwright install chromium
# PLAYWRIGHT_BROWSERS_PATH=/abs/path/to/Intent-Aware/.browsers

# Anthropic Claude (direct API — only used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-5             # current model; temperature is pinned to 0 for reproducibility

# OpenCode CLI brain (only used when LLM_PROVIDER=opencode). Auth comes from
# `opencode auth` (~/.local/share/opencode/auth.json) — no key needed here.
# Model is a fully-qualified provider/model id, verified live 2026-09-29
# (Zen claude-*, OpenRouter, tokengo, tokenrouter are unfunded/dead).
# OPENCODE_BIN=opencode                # auto-detected via PATH if unset
# OPENCODE_MODEL=fireworks-ai/accounts/fireworks/routers/qwen-max-latest
# Verified live 2026-09-29. Zen free-tier models (incl. opencode/big-pickle)
# REJECT the sandboxed brain agent (403 "free tier can only be used from within
# OpenCode") — do not set one as OPENCODE_MODEL. Other dead ends: Zen claude-*
# and OpenRouter 402, tokengo 401, tokenrouter 503.
# Cheaper verified alternative (same account):
# OPENCODE_MODEL=fireworks-ai/accounts/fireworks/routers/glm-flash-latest
# OPENCODE_TIMEOUT=900
# OPENCODE_VARIANT=                   # reasoning effort, provider-specific; blank = default
# OPENCODE_MODEL_PROVIDER=            # prefix for bare ids; blank = bare ids use OPENCODE_MODEL
# Sandbox: .opencode/agents/intent-brain.md (deny-all tools, used automatically
# when cwd is the project root). The child env is allowlisted — host secrets in
# this file never travel to the CLI. Sessions persist under opencode's data dir
# until CHAT TTL drops them server-side; the returned session_id is informational
# (chats are keyed per scan server-side). See OPENCODE_DATA_DIR in opencode docs.

# Ollama / Local / Cloud OpenAI-compatible
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3

# In-run LLM response cache (1=on). Cache hits do not consume the call budget.
LLM_CACHE=1
# Hard ceiling on LLM calls per process — once hit, brain stages degrade to heuristics.
LLM_MAX_CALLS=200

DATABASE_URL=postgresql://user:password@localhost:5432/qa_agent
MAX_TOKEN_BUDGET=100000
RATE_LIMIT_PER_SECOND=10
